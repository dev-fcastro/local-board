---
import logo from "../assets/logo.svg?raw";

const tools = [
  { name: "Select", d: "M5 3l13 8.5-6 1.6L9.2 19z" },
  { name: "Hand", d: "M8 12V6a1.5 1.5 0 0 1 3 0v5M11 11V4.5a1.5 1.5 0 0 1 3 0V11M14 11V6a1.5 1.5 0 0 1 3 0v7a6 6 0 0 1-6 6h-1a5 5 0 0 1-4.2-2.3L4 13.5a1.5 1.5 0 0 1 2.3-1.8L8 13.5" },
  { name: "Pen", d: "M4 20l4-1 11-11-3-3L5 16zM14 6l3 3" },
  { name: "Eraser", d: "M8 20h12M4.5 15.5l9-9a2 2 0 0 1 2.8 0l2.2 2.2a2 2 0 0 1 0 2.8l-8 8H8.5z" },
  { name: "Line", d: "M5 19L19 5" },
  { name: "Rectangle", d: "M4 6h16v12H4z" },
  { name: "Circle", d: "M19.5 12a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0z" },
  { name: "Text", d: "M5 6h14M12 6v13M9 19h6" },
  { name: "Sticky note", d: "M5 4h14v10l-5 6H5zM14 20v-6h5" },
];

const flow = [
  { x: 70, label: "Idea" },
  { x: 290, label: "Sketch" },
  { x: 510, label: "Review" },
  { x: 730, label: "Share" },
];
---

<div class="app" role="img" aria-label="Local Board app window: a board called Launch plan, saved on the computer while offline, with sticky notes and a simple idea-to-share workflow.">
  <div class="app-bar" aria-hidden="true">
    <div class="bar-file">
      <span class="bar-logo" set:html={logo} />
      <span class="-p">Launch plan</span>
    </div>
    <div class="bar-status">
      <span class="status-saved -p"><i></i>Saved</span>
      <span class="status-chip -p">Offline</span>
      <span class="status-zoom -p">100%</span>
    </div>
  </div>

  <div class="app-body" aria-hidden="true">
    <ul class="toolbar">
      {
        tools.map((tool, i) => (
          <li class:list={["tool", { "is-active": i === 2 }]} title={tool.name}>
            <svg viewBox="0 0 24 24" fill="none">
              <path d={tool.d} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </li>
        ))
      }
    </ul>

    <svg class="board" viewBox="0 0 1000 560" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="lb-dots" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" class="dot" />
        </pattern>
        <marker id="lb-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0L10 5L0 10z" class="arrowhead" />
        </marker>
      </defs>

      <rect width="1000" height="560" fill="url(#lb-dots)" />

      <text x="70" y="190" class="label">Launch workshop</text>

      {
        flow.map((node, i) => (
          <g>
            <rect x={node.x} y="210" width="170" height="64" rx="6" class="node" />
            <text x={node.x + 85} y="248" class="node-text" text-anchor="middle">{node.label}</text>
            {i < flow.length - 1 && (
              <line x1={node.x + 176} y1="242" x2={node.x + 214} y2="242" class="edge" marker-end="url(#lb-arrow)" />
            )}
          </g>
        ))
      }

      <g transform="rotate(-3 155 95)">
        <rect x="70" y="40" width="170" height="110" class="note note-amber" />
        <text x="86" y="74" class="note-text">Works with</text>
        <text x="86" y="98" class="note-text">Wi-Fi off ✓</text>
      </g>

      <g transform="rotate(2.5 850 95)">
        <rect x="760" y="36" width="180" height="112" class="note note-indigo" />
        <text x="776" y="70" class="note-text">Send to the</text>
        <text x="776" y="94" class="note-text">team as PDF</text>
      </g>

      <g transform="rotate(-1.5 190 420)">
        <rect x="90" y="350" width="210" height="130" class="note note-amber" />
        <text x="106" y="384" class="note-text">Next steps</text>
        <line x1="106" y1="408" x2="260" y2="408" class="note-rule" />
        <line x1="106" y1="428" x2="232" y2="428" class="note-rule" />
        <line x1="106" y1="448" x2="248" y2="448" class="note-rule" />
      </g>

      <path class="ink" d="M296 206c38-26 150-24 176 6 20 24-10 66-86 70-70 4-112-18-104-46 6-20 44-34 92-36" />

      <g class="selection">
        <rect x="722" y="202" width="186" height="80" class="sel-box" />
        <line x1="815" y1="202" x2="815" y2="182" class="sel-box" />
        <circle cx="815" cy="178" r="5" class="sel-handle" />
        <rect x="718" y="198" width="8" height="8" class="sel-handle" />
        <rect x="811" y="198" width="8" height="8" class="sel-handle" />
        <rect x="904" y="198" width="8" height="8" class="sel-handle" />
        <rect x="718" y="238" width="8" height="8" class="sel-handle" />
        <rect x="904" y="238" width="8" height="8" class="sel-handle" />
        <rect x="718" y="278" width="8" height="8" class="sel-handle" />
        <rect x="811" y="278" width="8" height="8" class="sel-handle" />
        <rect x="904" y="278" width="8" height="8" class="sel-handle" />
      </g>

      <path class="cursor" d="M918 292l0 30 8-7 6 13 5-2-6-13 10-1z" />

      <text x="420" y="470" class="hand-text">draft 3, saved locally</text>
    </svg>

    <div class="zoom -p" aria-hidden="true"><span>−</span><span>100%</span><span>+</span></div>
  </div>
</div>

<style>
  .app {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--canvas-elevated);
    color: var(--ink-primary);
  }

  .app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    height: 44px;
    padding: 0 1.6rem;
    border-bottom: 1px solid var(--line);
    background: var(--canvas);
    flex-shrink: 0;
  }

  .bar-file,
  .bar-status {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .bar-logo {
    width: 18px;
    flex-shrink: 0;
    color: var(--ink-primary);
  }

  .bar-logo :global(svg) {
    width: 100%;
    height: auto;
  }

  .status-saved {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-secondary);
  }

  .status-saved i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .status-chip {
    padding: 3px 8px;
    border: 1px solid var(--ink-primary);
    border-radius: 999px;
  }

  .status-zoom {
    display: none;
    color: var(--ink-secondary);
  }

  @media screen and (min-width: 750px) {
    .status-zoom {
      display: inline;
    }
  }

  @media screen and (max-width: 520px) {
    .status-saved {
      display: none;
    }
  }

  .app-body {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .board {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .toolbar {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 1.2rem;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 5px;
    border-radius: 10px;
    background: var(--canvas-elevated);
    box-shadow: 0 0 0 1px var(--line), 0 12px 32px -12px rgba(23, 24, 26, 0.35);
  }

  .tool {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    color: var(--ink-secondary);
  }

  .tool svg {
    width: 18px;
    height: 18px;
  }

  .tool.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  @media screen and (max-width: 749px) {
    .toolbar {
      top: auto;
      bottom: 1.2rem;
      transform: none;
      flex-direction: row;
    }

    .tool:nth-child(n + 7) {
      display: none;
    }
  }

  .zoom {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    display: flex;
    gap: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--canvas-elevated);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink-secondary);
  }

  .board :global(.dot) {
    fill: rgba(23, 24, 26, 0.2);
  }

  .board :global(.label) {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: var(--ink-secondary);
  }

  .board :global(.node) {
    fill: var(--canvas-elevated);
    stroke: var(--ink-primary);
    stroke-width: 1.5;
  }

  .board :global(.node-text) {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 500;
    fill: var(--ink-primary);
  }

  .board :global(.edge) {
    stroke: var(--ink-primary);
    stroke-width: 1.5;
  }

  .board :global(.arrowhead) {
    fill: var(--ink-primary);
  }

  .board :global(.note) {
    filter: drop-shadow(0 6px 10px rgba(23, 24, 26, 0.14));
  }

  .board :global(.note-amber) {
    fill: #fde68a;
  }

  .board :global(.note-indigo) {
    fill: #c7d2fe;
  }

  .board :global(.note-text) {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    fill: var(--ink-primary);
  }

  .board :global(.note-rule) {
    stroke: rgba(23, 24, 26, 0.3);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .board :global(.ink) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 720;
    stroke-dashoffset: 720;
    animation: draw 1.8s var(--ease-standard) 1.2s forwards;
  }

  .board :global(.sel-box) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .board :global(.sel-handle) {
    fill: var(--canvas-elevated);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .board :global(.cursor) {
    fill: var(--ink-primary);
    stroke: var(--canvas-elevated);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .board :global(.hand-text) {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--accent);
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .board :global(.ink) {
      animation: none;
      stroke-dashoffset: 0;
    }

    .status-saved i {
      animation: none;
    }
  }
</style>
