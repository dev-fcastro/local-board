---
const boards = [
  {
    name: "Launch plan",
    meta: "Edited today",
    art: `<rect x="14" y="16" width="34" height="26" fill="#fde68a"/><rect x="62" y="12" width="34" height="26" fill="#c7d2fe"/><rect x="110" y="18" width="34" height="26" fill="#fde68a"/><path d="M50 30h10M98 26h10" stroke="currentColor" stroke-width="1.5"/><path d="M20 70c20-14 40 10 62-4s36-2 58 6" stroke="var(--accent)" stroke-width="2.5" fill="none" stroke-linecap="round"/>`,
  },
  {
    name: "Class notes",
    meta: "Yesterday",
    art: `<path d="M16 20h70M16 32h96M16 44h58M16 56h84M16 68h46" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="130" cy="58" r="16" stroke="var(--accent)" stroke-width="2" fill="none"/>`,
  },
  {
    name: "Site survey",
    meta: "Last week",
    art: `<path d="M20 70c14-30 44-36 60-26s28 34 58 18" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M34 76c14-22 36-26 48-18s24 24 48 12" stroke="currentColor" stroke-width="1.5" fill="none" opacity=".5"/><circle cx="96" cy="34" r="5" fill="var(--accent)"/><rect x="118" y="12" width="28" height="22" fill="#fde68a"/>`,
  },
  {
    name: "Team retro",
    meta: "In March",
    art: `<path d="M56 10v74M106 10v74" stroke="currentColor" stroke-width="1" opacity=".4"/><rect x="14" y="16" width="30" height="20" fill="#fde68a"/><rect x="14" y="44" width="30" height="20" fill="#fde68a"/><rect x="66" y="16" width="30" height="20" fill="#c7d2fe"/><rect x="118" y="16" width="30" height="20" fill="#fde68a"/><rect x="118" y="44" width="30" height="20" fill="#c7d2fe"/>`,
  },
];

const promises = [
  {
    tag: "Always",
    title: "No account needed",
    text: "Install it and start drawing. No sign-up, no login, no email address.",
  },
  {
    tag: "Always",
    title: "Works offline",
    text: "Open, edit and save your boards with no internet connection at all.",
  },
  {
    tag: "Always",
    title: "Your files, your computer",
    text: "Boards are saved where you decide. Nobody else keeps a copy.",
  },
  {
    tag: "First release",
    title: "Never lose your work",
    text: "Everything saves as you go, and your board reopens exactly where you left it.",
  },
  {
    tag: "Coming soon",
    title: "Share as image or PDF",
    text: "Turn any board into an image or a PDF to send, print or present.",
  },
  {
    tag: "Later",
    title: "Your cloud, if you want it",
    text: "Keep boards in Google Drive, OneDrive or Dropbox, only if you choose to.",
  },
];
---

<section class="boards" id="your-boards" aria-labelledby="boards-title">
  <div class="boards-panel">
    <div class="panel-inner">
      <div class="panel-visual" data-mask>
        <div class="folder" aria-hidden="true">
          <p class="folder-path -p">This computer › Boards</p>
          <ul class="folder-grid">
            {
              boards.map((board) => (
                <li class="board-card">
                  <svg class="board-thumb" viewBox="0 0 160 90" fill="none" set:html={board.art} />
                  <p class="board-name">{board.name}</p>
                  <p class="board-meta -p">{board.meta}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="panel-content">
        <p class="panel-meta -p" data-reveal>Your boards · Always yours</p>
        <h2 class="panel-title -t5" id="boards-title" data-reveal>Your boards are files you own.</h2>
        <p class="panel-text -p" data-reveal>
          Every board is saved on your computer, like any other document. Copy it, back it up,
          put it on a USB stick or email it. It stays yours.
        </p>
        <a class="panel-button -p" href="#promises" data-reveal>What you can count on</a>
      </div>
    </div>
  </div>

  <ul class="promises" id="promises" aria-label="What you can count on">
    {
      promises.map((item) => (
        <li class="promise">
          <span class="rule rule-bottom" data-line="x" aria-hidden="true" />
          <span class="rule rule-side" data-line="y" aria-hidden="true" />
          <p class="promise-tag -p">{item.tag}</p>
          <div>
            <h3 class="promise-title -p2" data-reveal>{item.title}</h3>
            <p class="promise-text -p" data-reveal>{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .boards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--ink-primary);
  }

  @media screen and (min-width: 1025px) {
    .boards {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------- sticky panel ---------- */

  .boards-panel {
    color: var(--canvas);
  }

  .panel-inner {
    display: flex;
    flex-direction: column;
  }

  @media screen and (min-width: 1025px) {
    .panel-inner {
      position: sticky;
      top: 0;
      min-height: 100vh;
      min-height: 100svh;
    }
  }

  .panel-visual {
    display: flex;
    align-items: center;
    padding: 4rem 1.6rem;
    background:
      radial-gradient(circle at 1px 1px, var(--line-on-dark) 1px, transparent 0) 0 0 / 20px 20px,
      var(--ink-raised);
    border-bottom: 1px solid var(--line-on-dark);
  }

  @media screen and (min-width: 750px) {
    .panel-visual {
      padding: 5.6rem 4rem;
    }
  }

  @media screen and (min-width: 1025px) {
    .panel-visual {
      flex: 1;
    }
  }

  .folder {
    width: 100%;
    padding: 1.6rem;
    border-radius: 10px;
    background: var(--canvas);
    color: var(--ink-primary);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }

  @media screen and (min-width: 750px) {
    .folder {
      padding: 2.4rem;
    }
  }

  .folder-path {
    margin-bottom: 1.6rem;
    color: var(--ink-secondary);
  }

  .folder-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .folder-grid {
      gap: 1.6rem;
    }
  }

  .board-card {
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--canvas-elevated);
  }

  .board-card:first-child {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .board-thumb {
    width: 100%;
    height: auto;
    margin-bottom: 1rem;
    border-radius: 4px;
    background: radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 10px 10px;
    color: var(--ink-primary);
  }

  .board-name {
    font-size: clamp(13px, 1.5rem, 18px);
    font-weight: 500;
  }

  .board-meta {
    color: var(--ink-tertiary);
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.4rem;
    padding: 3.2rem 1.6rem 4.8rem;
  }

  @media screen and (min-width: 750px) {
    .panel-content {
      padding: 4rem;
    }
  }

  .panel-meta,
  .panel-text {
    color: var(--ink-tertiary);
  }

  .panel-title {
    max-width: 16ch;
  }

  .panel-text {
    max-width: 52ch;
  }

  .panel-button {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--canvas);
    color: var(--ink-primary);
    border: 1px solid var(--canvas);
    transition: background 0.25s, color 0.25s;
  }

  .panel-button:hover {
    background: transparent;
    color: var(--canvas);
  }

  /* ---------- promises grid ---------- */

  .promises {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--surface);
  }

  @media screen and (min-width: 750px) {
    .promises {
      grid-template-columns: 1fr 1fr;
    }
  }

  .promise {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    min-height: 28rem;
    padding: 2.4rem 1.6rem 3.2rem;
    transition: background 0.4s var(--ease-standard), color 0.4s var(--ease-standard);
  }

  @media screen and (min-width: 750px) {
    .promise {
      min-height: 40rem;
      padding: 4rem;
    }
  }

  .promise:hover {
    background: var(--ink-primary);
    color: var(--canvas);
  }

  .promise-tag {
    align-self: flex-start;
    padding: 4px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .promise-title {
    margin-bottom: 1.6rem;
  }

  .promise-text {
    max-width: 40ch;
    color: var(--ink-secondary);
    transition: color 0.4s;
  }

  .promise:hover .promise-text {
    color: var(--ink-tertiary);
  }

  .rule {
    position: absolute;
    background: var(--line);
    pointer-events: none;
  }

  .rule-bottom {
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    transform-origin: left center;
  }

  .rule-side {
    top: 0;
    right: 0;
    width: 1px;
    height: 100%;
    transform-origin: center top;
  }

  @media screen and (max-width: 749px) {
    .rule-side {
      display: none;
    }
  }
</style>
