---
import logo from "../assets/logo.svg?raw";

const maker = {
  name: "Francisco Castro",
  role: "Freelance software engineer · Santo Domingo, DR",
  pitch: "I build web, mobile and desktop products end to end — .NET, Flutter, Angular, offline-first systems and CI/CD. Local Board is one of my open-source projects.",
  links: [
    { href: "https://www.fcastro.site/", label: "Portfolio" },
    { href: "https://www.fcastro.site/about", label: "About me" },
    { href: "https://github.com/dev-fcastro", label: "GitHub" },
    { href: "https://linkedin.com/in/fcastrodev", label: "LinkedIn" },
    { href: "https://sellernet.vercel.app/", label: "DgiiEcf (open source)" },
  ],
  contact: [
    { href: "mailto:fcastrodev1@proton.me", label: "fcastrodev1@proton.me" },
    { href: "https://wa.me/18093216900?text=Hola%20Francisco%2C%20vi%20Local%20Board%20y%20quiero%20conversar%20sobre%20un%20proyecto", label: "WhatsApp" },
  ],
};

const nav = [
  {
    title: "Product",
    links: [
      { href: "/#use-cases", label: "Use cases" },
      { href: "/#your-boards", label: "Your boards" },
      { href: "/download", label: "Download" },
    ],
  },
  {
    title: "More",
    links: [
      { href: "/#early-access", label: "Early access" },
      { href: "/terms", label: "Terms & conditions" },
      { cookies: true, label: "Cookie settings" },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-inner -w">
    <div class="footer-block" data-mask>
      <div class="block-row">
        <a class="footer-logo" href="/" aria-label="Local Board — home" set:html={logo} />

        {
          nav.map((group) => (
            <nav class="footer-nav" aria-label={group.title}>
              <p class="nav-title -p2">
                {group.title}
                <sup>{group.links.length}</sup>
              </p>
              <ul>
                {group.links.map((link) => (
                  <li>
                    {"cookies" in link ? (
                      <button class="nav-link -p2" type="button" data-cookie-settings>
                        <span class="nav-arrow" aria-hidden="true">↳</span>
                        {link.label}
                      </button>
                    ) : (
                      <a class="nav-link -p2" href={link.href}>
                        <span class="nav-arrow" aria-hidden="true">↳</span>
                        {link.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>

      <div class="maker" id="maker">
        <div>
          <p class="maker-eyebrow -p">Made by</p>
          <p class="maker-name -t5">
            <a href="https://www.fcastro.site/" rel="author">{maker.name}</a>
          </p>
          <p class="maker-role -p">{maker.role}</p>
        </div>
        <div>
          <p class="maker-pitch -p2">{maker.pitch}</p>
          <p class="maker-cta -p">Need something built? I'm available for freelance work.</p>
          <ul class="maker-links">
            {
              [...maker.links, ...maker.contact].map((l) => (
                <li>
                  <a class="nav-link -p" href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                    <span class="nav-arrow" aria-hidden="true">↗</span>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="block-row block-row-meta">
        <p class="-p meta-line">The board belongs to you,<br />not to the service.</p>
        <p class="-p">No account required.<br />Works offline.<br />Your boards, your computer.</p>
      </div>

      <svg class="wordmark" viewBox="0 0 1000 158" aria-hidden="true">
        <text x="0" y="140" textLength="1000" lengthAdjust="spacingAndGlyphs"
          ><tspan font-weight="700">LOCAL</tspan><tspan font-weight="400">BOARD</tspan></text
        >
      </svg>
    </div>

    <div class="footer-copy -p">
      <p>© 2026 Local Board · MIT · by <a href="https://www.fcastro.site/" rel="author">Francisco Castro</a></p>
      <a href="https://github.com/dev-fcastro/local-board" target="_blank" rel="noopener">Source on GitHub</a>
      <p>Built to work with the lights off.</p>
      <a href="/terms">Terms & conditions</a>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll("[data-cookie-settings]").forEach((btn) =>
    btn.addEventListener("click", () => window.dispatchEvent(new CustomEvent("lb:cookie-settings"))),
  );
</script>

<style>
  .footer {
    background: var(--accent);
    color: var(--accent-ink);
    padding-bottom: 1.6rem;
  }

  .footer-block {
    display: flex;
    flex-direction: column;
    gap: 6.4rem;
    padding: 3.2rem 1.6rem 1.6rem;
    border-radius: 8px;
    background: var(--ink-primary);
    color: var(--accent-on-dark);
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .footer-block {
      gap: 8rem;
      padding: 5.6rem 4rem 3.2rem;
    }
  }

  .block-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.2rem 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .block-row {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 4rem;
    }
  }

  .footer-logo {
    grid-column: 1 / -1;
    width: 5.6rem;
    color: var(--accent-on-dark);
  }

  @media screen and (min-width: 750px) {
    .footer-logo {
      grid-column: auto;
      width: clamp(48px, 6.4rem, 80px);
    }
  }

  .footer-logo :global(svg) {
    width: 100%;
    height: auto;
  }

  .nav-title {
    margin-bottom: 1.2rem;
    color: var(--canvas);
  }

  .nav-title sup {
    font-size: 0.5em;
    margin-left: 2px;
  }

  .nav-link {
    display: inline-flex;
    gap: 1.2rem;
    padding: 0.2rem 0;
    text-align: left;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--canvas);
  }

  .nav-arrow {
    font-size: 0.7em;
    padding-top: 0.2em;
  }

  .block-row-meta {
    color: var(--ink-tertiary);
  }

  .maker {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    padding-top: 3.2rem;
    border-top: 1px solid var(--line-on-dark);
  }

  @media screen and (min-width: 750px) {
    .maker {
      grid-template-columns: 2fr 2fr;
      gap: 4rem;
    }
  }

  .maker-eyebrow,
  .maker-role {
    color: var(--ink-tertiary);
  }

  .maker-name {
    margin: 0.8rem 0;
    color: var(--canvas);
  }

  .maker-name a:hover {
    color: var(--accent-on-dark);
  }

  .maker-pitch {
    max-width: 48ch;
    color: var(--canvas);
  }

  .maker-cta {
    margin-top: 1.6rem;
    color: var(--accent-on-dark);
  }

  .maker-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.4rem;
    margin-top: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .meta-line {
      grid-column: 2;
    }
  }

  .wordmark {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .wordmark text {
    font-family: var(--font-sans);
    font-size: 176px;
    letter-spacing: -0.02em;
    fill: var(--accent);
  }

  .footer-copy {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 2.4rem;
    padding-top: 1.6rem;
  }

  .footer-copy a:hover {
    text-decoration: underline;
  }
</style>
