---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const updated = "28 September 2026";

const sections = [
  {
    id: "agreement",
    title: "Agreement",
    body: [
      "These terms apply when you download, install or use Local Board (the app), and when you visit this website. By doing any of those, you agree to them. If you don't agree, please don't use the app or the site.",
    ],
  },
  {
    id: "the-app",
    title: "The app",
    body: [
      "Local Board is a whiteboard for your computer. It works without an account and without an internet connection, and it saves your boards on your own device.",
      "During early access, features may change, and some described on this site may not be available yet.",
    ],
  },
  {
    id: "your-boards",
    title: "Your boards",
    body: [
      "Everything you create in Local Board belongs to you. Your boards are stored on your device, or in a place you choose.",
      "We don't receive, host or have access to your boards unless you decide to send them to us yourself.",
      "Because your boards live on your device, you're responsible for keeping backups of the ones that matter to you.",
    ],
  },
  {
    id: "cloud",
    title: "Cloud storage you choose",
    body: [
      "If you decide to keep your boards in a service like Google Drive, OneDrive or Dropbox, your use of that service is covered by its own terms and privacy policy, not by these ones. We're not responsible for how those services work.",
    ],
  },
  {
    id: "license",
    title: "Using the app",
    body: [
      "We give you a personal, non-exclusive and non-transferable permission to install and use the app on your own devices.",
      "You may not sell, rent or redistribute the app, or remove any notices included with it. The full license for each release, including any third-party components it uses, is published alongside that release.",
    ],
  },
  {
    id: "acceptable-use",
    title: "Acceptable use",
    body: [
      "Don't use the app or this website to break the law, to infringe on anyone else's rights, or to try to disrupt or damage the website.",
    ],
  },
  {
    id: "cookies",
    title: "Cookies on this website",
    body: [
      "This website only stores one thing in your browser: your cookie choice, so we don't ask you again on every visit. It's kept in your browser's local storage and never leaves your device.",
      "We don't use analytics, advertising or tracking cookies today. If that ever changes, those cookies stay off unless you allow them.",
      "You can change your choice at any time from “Cookie settings” at the bottom of every page.",
    ],
  },
  {
    id: "no-warranty",
    title: "No warranty",
    body: [
      "The app is provided “as is”. We work hard to keep your boards safe, but we can't promise the app will always be free of errors or interruptions, especially during early access.",
    ],
  },
  {
    id: "liability",
    title: "Limitation of liability",
    body: [
      "To the extent the law allows, we're not liable for indirect or consequential losses, or for loss of data, arising from your use of the app or the website.",
    ],
  },
  {
    id: "changes",
    title: "Changes to these terms",
    body: [
      "We may update these terms. When we do, we'll change the date at the top of this page. If you keep using the app or the site after an update, the new terms apply.",
    ],
  },
  {
    id: "contact",
    title: "Contact",
    body: ["Questions about these terms? Contact details will be published here before the first release."],
  },
];
---

<Base
  title="Terms & conditions — Local Board"
  description="The terms for using Local Board and this website: your boards are yours, no account needed, cookies kept to a minimum."
>
  <PageHero
    eyebrow={`Legal · Draft · Last updated ${updated}`}
    lines={["Terms &", "conditions"]}
    description="The short version: your boards are yours, the app works without an account, and this site keeps cookies to a minimum."
  />

  <div class="legal -w">
    <nav class="toc" aria-label="On this page">
      <p class="toc-title -p">On this page</p>
      <ol>
        {
          sections.map((s, i) => (
            <li>
              <a class="toc-link" href={`#${s.id}`}>
                <span class="-p toc-num">{String(i + 1).padStart(2, "0")}</span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="article">
      {
        sections.map((s, i) => (
          <section class="clause" id={s.id}>
            <p class="clause-num -p">{String(i + 1).padStart(2, "0")}</p>
            <h2 class="clause-title -p2">{s.title}</h2>
            {s.body.map((p) => (
              <p class="clause-text">{p}</p>
            ))}
          </section>
        ))
      }
    </article>
  </div>
</Base>

<style>
  .legal {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.8rem;
    padding-top: 6.4rem;
    padding-bottom: 10rem;
  }

  @media screen and (min-width: 1025px) {
    .legal {
      grid-template-columns: 36rem 1fr;
      gap: 8rem;
      padding-top: 10rem;
      padding-bottom: 14rem;
    }
  }

  .toc {
    display: none;
  }

  @media screen and (min-width: 1025px) {
    .toc {
      display: block;
      position: sticky;
      top: 4rem;
      align-self: start;
    }
  }

  .toc-title {
    margin-bottom: 1.6rem;
    color: var(--ink-secondary);
  }

  .toc-link {
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: baseline;
    padding: 0.8rem 0;
    border-top: 1px solid var(--line);
    font-size: clamp(14px, 1.5rem, 18px);
    transition: color 0.2s;
  }

  .toc-link:hover {
    color: var(--accent);
  }

  .toc-num {
    color: var(--ink-tertiary);
  }

  .article {
    max-width: 72ch;
  }

  .clause {
    padding: 3.2rem 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 2.4rem;
  }

  .clause:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .clause-num {
    margin-bottom: 1.2rem;
    color: var(--accent);
  }

  .clause-title {
    margin-bottom: 1.6rem;
  }

  .clause-text {
    font-size: clamp(16px, 1.8rem, 20px);
    line-height: 1.6;
    color: var(--ink-secondary);
  }

  .clause-text + .clause-text {
    margin-top: 1.2rem;
  }

  .clause:target .clause-title {
    color: var(--accent);
  }
</style>
