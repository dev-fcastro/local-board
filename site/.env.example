# SMTP for early-access sign-ups. Never commit real values:
# set them in Vercel → Project → Settings → Environment Variables.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Local Board <no-reply@example.com>"
# Where new sign-ups are reported.
EARLY_ACCESS_NOTIFY_TO=you@example.com
